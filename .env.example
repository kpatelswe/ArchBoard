GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Neon pooled endpoint (host contains "-pooler") — used by the app at runtime.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb

# Neon direct endpoint (same host without "-pooler") — used by Alembic migrations only.
DATABASE_MIGRATION_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb
